# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://appnation:appnation_dev@localhost:5432/ai_chat?schema=public

# JWT
JWT_SECRET=your-secret-key-change-in-production

# OpenAI (optional - for real AI completions; set MOCK_AI=true to use simulated responses)
OPENAI_API_KEY=sk-your-openai-api-key
MOCK_AI=false

# Feature Flags (can also be set via feature-flags.json)
FF_STREAMING_ENABLED=true
FF_PAGINATION_LIMIT=20
FF_AI_TOOLS_ENABLED=true
FF_CHAT_HISTORY_ENABLED=true

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Logging
LOG_LEVEL=debug
